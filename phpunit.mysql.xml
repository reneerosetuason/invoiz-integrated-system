<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dedicated MySQL test configuration for the isolated sandbox only.

  Sandbox instance: 127.0.0.1:3308
  Sandbox database: invoiz_ecommerce_sandbox
  Datadir: C:\Users\ilaga\invoiz_sandbox_data

  Tests\TestCase enforces a positive allowlist on this exact tuple. Ports
  3306/3307 and databases invoiz_ecommerce_db, invoiz_ecommerce_test and
  invoizdb are explicitly blocked.

  The two RefreshDatabase suites are excluded because migrations 190000 and
  210000 hard-require `invoiz_ecommerce_test` and its seeded accounts, so
  `migrate:fresh` cannot safely rebuild the sandbox. Do not run them until a
  separately approved sandbox migration strategy exists.

  USAGE:  php artisan test -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache.mysql">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/GlobalLogisticsAdminArchitectureTest.php</exclude>
            <exclude>tests/Feature/HubTransferWorkflowTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3308"/>
        <env name="DB_DATABASE" value="invoiz_ecommerce_sandbox"/>
        <env name="DB_USERNAME" value="invoiz_test"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
    </php>
</phpunit>
