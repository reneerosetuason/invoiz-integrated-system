# INVOIZ Rider App — Environment Configuration
# Copy this file to .env. Leave the URL empty to use AppConfig's
# platform-specific development default, or set a reachable URL below.

# Laravel logistics API base URL (include the full /api/logistics prefix).
#   Android emulator:  http://10.0.2.2:8000/api/logistics
#   Physical device:   http://YOUR-PC-LAN-IP:8000/api/logistics
#   Web/desktop:       http://127.0.0.1:8000/api/logistics
#   Production:        https://YOUR-DOMAIN/api/logistics
# The URL is configuration, not a credential. Never put secrets in this file.
API_BASE_URL=
