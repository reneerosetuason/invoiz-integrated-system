# Copy to .runtime/container.env (ignored); never use your development .env.
APP_NAME=INVOIZ
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8085
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=invoiz_lab_container
DB_USERNAME=invoiz_lab
DB_PASSWORD=replace-with-a-disposable-lab-password
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr
SESSION_COOKIE=invoiz_lab_session
SESSION_SECURE_COOKIE=false
